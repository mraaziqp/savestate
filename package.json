{
  "name": "nexusemu",
  "private": true,
  "version": "1.0.59",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "build:prod": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "desktop:dev": "tauri dev",
    "desktop:safe": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\start-nexus-desktop-safe.ps1",
    "desktop:installed:safe": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\launch-installed-nexusemu-safe.ps1",
    "desktop:pack": "tauri build --bundles nsis",
    "desktop:pack:linux": "tauri build --bundles appimage",
    "desktop:pack:mac": "tauri build --bundles dmg",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "release": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\release.ps1",
    "mobile:android:add": "npx cap add android",
    "mobile:sync": "npm run build && npx cap sync android",
    "mobile:apk": "npm run mobile:sync && cd android && gradlew.bat assembleDebug",
    "mobile:apk:release": "npm run mobile:sync && cd android && gradlew.bat assembleRelease",
    "host:start": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\start-nexus.ps1",
    "host:start:public": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\start-nexus.ps1 -PublicTunnel",
    "host:start:public:stable": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\start-nexus.ps1 -NamedTunnel",
    "host:tunnel:start": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\start-cloudflare-tunnel.ps1 -InstallIfMissing -StopExisting",
    "host:tunnel:named": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\start-cloudflare-named-tunnel.ps1",
    "host:roadcheck": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\road-ready-check.ps1",
    "host:roadstart": "npm run host:start && npm run host:roadcheck",
    "host:run": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\run-nexus-host.ps1",
    "host:install": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\install-nexus-host-task.ps1 -OpenFirewall",
    "host:uninstall": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\uninstall-nexus-host-task.ps1",
    "host:status": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\host-status.ps1",
    "host:backup": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\export-nexus-portable.ps1",
    "host:quickstart": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\quickstart-laptop-host.ps1",
    "host:state:export": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\export-host-state.ps1",
    "host:state:import": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\import-host-state.ps1",
    "release:channel": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\prepare-release-channel.ps1",
    "qa:certify": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\qa-certify.ps1",
    "sale:ready": "npm run lint && npm run qa:certify && npm run release:channel",
    "updates:publish": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\publish-updates.ps1",
    "updates:publish:start": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\publish-updates.ps1 -StartServer",
    "updates:publish:linux": "bash ./publish-updates.sh",
    "linux:setup": "bash ./quickstart-zorin-host.sh",
    "linux:start": "bash ./nexus.sh start",
    "linux:stop": "bash ./nexus.sh stop",
    "linux:restart": "bash ./nexus.sh restart",
    "linux:status": "bash ./nexus.sh status",
    "linux:domain": "bash ./nexus.sh domain",
    "linux:logs": "bash ./nexus.sh logs",
    "linux:update": "bash ./nexus.sh update",
    "build:installer": "node scripts/build-installer.cjs",
    "test:launcher": "node scripts/test-launcher-setup.cjs"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/cli": "^6.2.0",
    "@capacitor/core": "^6.2.0",
    "@capacitor/filesystem": "^6.0.4",
    "@google/genai": "^1.29.0",
    "@tailwindcss/vite": "^4.1.14",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@types/adm-zip": "^0.5.8",
    "@types/compression": "^1.8.1",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-react": "^5.0.4",
    "7zip-bin": "^5.2.0",
    "adm-zip": "^0.5.17",
    "chokidar": "^5.0.0",
    "compression": "^1.8.1",
    "dotenv": "^17.4.2",
    "epubjs": "^0.3.93",
    "express": "^4.22.1",
    "express-rate-limit": "^8.6.2",
    "hls.js": "^1.6.16",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^2.1.1",
    "pdfjs-dist": "^5.7.284",
    "pg": "^8.20.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "sharp": "^0.34.5",
    "tsx": "^4.21.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^8.0.10",
    "vite-plugin-pwa": "^1.3.0"
  },
  "author": "NexusEmu",
  "description": "AI-powered emulator frontend with cross-platform cloud sync"
}
